# Server API
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development

# Unified version (optional — defaults to package.json version)
APP_VERSION=

# Customer-server installation identity (required in production)
# Generated once during customer server installation and included in signed license payloads.
FRATELANZA_INSTALLATION_ID=

# PostgreSQL (Server — customer business data lives here)
DATABASE_URL=postgresql://fratelanza:fratelanza_dev@localhost:5432/fratelanza_erp?schema=public

# SQLite (Desktop legacy sync experiments — not used for LAN MVP business data)
LOCAL_DATABASE_URL=file:./data/fratelanza-local.db

# JWT — MUST be unique per customer installation in production (≥32 characters)
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — production: LAN desktop origins, e.g. http://192.168.1.10:5173
CORS_ORIGINS=http://localhost:5173

# Sync (disabled for LAN MVP — set true only for legacy offline sync experiments)
SYNC_ENABLED=false

# Party legacy adapter routing (deployment flag — not a commercial entitlement)
PARTY_LEGACY_ROUTING_ENABLED=false
PURCHASING_PARTY_ROUTING_ENABLED=false

# Universal Finance migration pilot (Phase 8.2 — PO receive only when true)
UNIVERSAL_FINANCE_PILOT_ENABLED=false

# Universal Finance Sales migration pilot (Phase 8.3 — Sales invoice post only when true)
UNIVERSAL_FINANCE_SALES_PILOT_ENABLED=false

# Commercial licensing (Ed25519)
# Customer installations receive ONLY LICENSE_VERIFICATION_PUBLIC_KEY (never the private key).
# Single-line .env form is supported — use \n for line breaks inside the PEM.
# Example:
# LICENSE_VERIFICATION_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEA...\n-----END PUBLIC KEY-----\n"
LICENSE_VERIFICATION_PUBLIC_KEY=
# Issuance private key — Fratelanza licensing authority (mg.fratelanza.com) / local test only.
# NEVER ship to customer production servers.
LICENSE_SIGNING_PRIVATE_KEY=
# Development-only bypass (never enable in production)
LICENSE_ALLOW_UNSIGNED_DEV=false

# Production checklist (NODE_ENV=production):
# - Strong JWT_SECRET (unique, ≥32 chars)
# - LICENSE_VERIFICATION_PUBLIC_KEY set
# - LICENSE_ALLOW_UNSIGNED_DEV=false
# - LICENSE_SIGNING_PRIVATE_KEY unset
# - FRATELANZA_INSTALLATION_ID set
# - CORS_ORIGINS restricted to customer LAN desktop origins
# - Do NOT run demo db:seed on production without changing admin password
