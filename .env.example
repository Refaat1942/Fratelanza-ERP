# Fratelanza Business Platform — Environment Template
# Copy to .env and adjust for your installation.

# Server API
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development

# Unified version (optional — defaults to package.json version)
APP_VERSION=

# PostgreSQL
# Evaluation / local development: use fratelanza_eval ONLY (safe to reset)
# Production customer data: use a dedicated database — NEVER fratelanza_eval
DATABASE_URL=postgresql://fratelanza:fratelanza_dev@localhost:5432/fratelanza_eval?schema=public

# SQLite (Desktop local cache — not primary business data in LAN MVP)
LOCAL_DATABASE_URL=file:./data/fratelanza-local.db

# JWT — MUST be unique per customer installation in production (≥32 characters)
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated origins for desktop app)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo seed password (local evaluation only — see docs/DEMO_CREDENTIALS.md)
# DEMO_SEED_PASSWORD=Eval@2026!Demo

# Set to true to have `npm run seed` (re)create the default public /demo/*
# links. Defaults to false so deleting demo links in Control Center isn't
# undone by the next seed run.
# SEED_DEMO_LINKS=true

# Feature flags (optional)
# SYNC_ENABLED=false
# PARTY_LEGACY_ROUTING_ENABLED=false

# AI Assistant (in-app bilingual chat, answers "how do I..." questions and
# looks up live tenant data via tool use). Leave unset to disable the
# assistant — the UI shows a "not configured" message instead of erroring.
# Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
# ASSISTANT_MODEL=claude-opus-5

# SaaS billing (subscription checkout + webhooks). Leave unset to disable
# that provider — checkout requests return a clear "not configured" error
# instead of crashing, and its webhook endpoint still exists but has
# nothing to verify against.
# Stripe: https://dashboard.stripe.com/apikeys / .../webhooks
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Paymob: https://accept.paymob.com/portal2/en/api-keys
# PAYMOB_API_KEY=...
# PAYMOB_HMAC_SECRET=...
# PAYMOB_INTEGRATION_ID=...
# PAYMOB_IFRAME_ID=...
