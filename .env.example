# Server API
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL (Server)
DATABASE_URL=postgresql://fratelanza:fratelanza_dev@localhost:5432/fratelanza_erp?schema=public

# SQLite (Desktop/Local)
LOCAL_DATABASE_URL=file:./data/fratelanza-local.db

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGINS=http://localhost:5173

# Sync
SYNC_BATCH_SIZE=100
SYNC_RETRY_MAX=5
