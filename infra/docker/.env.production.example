# Production environment for https://G-ERP.fratelanza.com
# Copy to .env.production on the VPS — do NOT commit secrets

NODE_ENV=production
APP_URL=https://g-erp.fratelanza.com
FRONTEND_URL=https://g-erp.fratelanza.com
CORS_ORIGINS=https://g-erp.fratelanza.com

API_HOST=0.0.0.0
API_PORT=3000

# Use evaluation/demo database on staging; switch to production DB only when ready
DATABASE_URL=postgresql://fratelanza:CHANGE_ME@postgres:5432/fratelanza_eval?schema=public
POSTGRES_USER=fratelanza
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=fratelanza_eval

JWT_SECRET=CHANGE_ME_TO_A_STRONG_32_CHAR_MINIMUM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

DEMO_SEED_PASSWORD=Eval@2026!Demo
