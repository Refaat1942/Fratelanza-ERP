# Production environment for https://g-erp.fratelanza.com
# Copy to infra/docker/.env.production on the VPS — do NOT commit secrets

NODE_ENV=production
APP_URL=https://g-erp.fratelanza.com
FRONTEND_URL=https://g-erp.fratelanza.com
CORS_ORIGINS=https://g-erp.fratelanza.com

API_HOST=0.0.0.0
API_PORT=3000

# Dedicated G-ERP SaaS database — NEVER use fratelanza_erp
POSTGRES_USER=fratelanza
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=fratelanza_g_erp_prod
DATABASE_URL=postgresql://fratelanza:CHANGE_ME_STRONG_PASSWORD@postgres:5432/fratelanza_g_erp_prod?schema=public

JWT_SECRET=CHANGE_ME_TO_A_STRONG_32_CHAR_MINIMUM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

DEMO_SEED_PASSWORD=Eval@2026!Demo
