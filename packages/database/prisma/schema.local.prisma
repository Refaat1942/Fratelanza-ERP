generator client {
  provider = "prisma-client-js"
  output   = "../generated/local"
}

datasource db {
  provider = "sqlite"
  url      = env("LOCAL_DATABASE_URL")
}

// Local SQLite schema mirrors server core entities for offline operation.
// Sync metadata fields are included on all syncable entities.

model Tenant {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  isActive  Boolean   @default(true)
  settings  String    @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  syncStatus     String   @default("synced")
  version        Int      @default(1)
  lastSyncedAt   DateTime?

  branches Branch[]
  users    User[]
  roles    Role[]
  devices  Device[]

  @@map("tenants")
}

model Branch {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  code      String
  address   String?
  phone     String?
  email     String?
  isActive  Boolean   @default(true)
  isDefault Boolean   @default(false)
  settings  String    @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  syncStatus     String   @default("pending")
  version        Int      @default(1)
  lastSyncedAt   DateTime?
  deviceId       String?

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  warehouses Warehouse[]
  users      User[]
  devices    Device[]

  @@unique([tenantId, code])
  @@map("branches")
}

model Warehouse {
  id        String    @id @default(uuid())
  tenantId  String
  branchId  String
  name      String
  code      String
  address   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  syncStatus     String   @default("pending")
  version        Int      @default(1)
  lastSyncedAt   DateTime?
  deviceId       String?

  branch Branch @relation(fields: [branchId], references: [id])
  stockBalances StockBalance[]

  @@unique([tenantId, code])
  @@map("warehouses")
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  branchId     String?
  roleId       String
  email        String
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  locale       String    @default("en")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  syncStatus     String   @default("pending")
  version        Int      @default(1)
  lastSyncedAt   DateTime?
  deviceId       String?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([tenantId, email])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  code        String
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  syncStatus     String   @default("pending")
  version        Int      @default(1)
  lastSyncedAt   DateTime?

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  users       User[]
  permissions RolePermission[]

  @@unique([tenantId, code])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  module      String
  feature     String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([module, feature, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Device {
  id          String    @id @default(uuid())
  tenantId    String
  branchId    String?
  name        String
  fingerprint String    @unique
  os          String?
  appVersion  String?
  status      String    @default("active")
  lastSeenAt  DateTime?
  activatedAt DateTime  @default(now())
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  syncStatus     String   @default("synced")
  version        Int      @default(1)
  lastSyncedAt   DateTime?

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@map("devices")
}

model SyncQueue {
  id             String    @id @default(uuid())
  tenantId       String
  deviceId       String
  entityType     String
  entityId       String
  operation      String
  payload        String
  version        Int       @default(1)
  status         String    @default("pending")
  retryCount     Int       @default(0)
  lastError      String?
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())
  processedAt    DateTime?

  @@index([status, createdAt])
  @@map("sync_queue")
}

model SyncLog {
  id          String    @id @default(uuid())
  tenantId    String
  deviceId    String
  direction   String
  entityType  String?
  recordCount Int       @default(0)
  status      String
  message     String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@map("sync_logs")
}

model SyncConflict {
  id            String    @id @default(uuid())
  tenantId      String
  deviceId      String
  entityType    String
  entityId      String
  localVersion  String
  serverVersion String
  resolution    String?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@map("sync_conflicts")
}

model SyncCursor {
  id         String   @id @default(uuid())
  tenantId   String
  deviceId   String
  entityType String
  cursor     String
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, deviceId, entityType])
  @@map("sync_cursors")
}

model AppMeta {
  id    String @id @default("singleton")
  key   String @unique
  value String

  @@map("app_meta")
}

// ─── ERP (offline cache) ───────────────────────────────────────────

model UnitOfMeasure {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  code      String
  symbol    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  syncStatus   String   @default("pending")
  version      Int      @default(1)
  lastSyncedAt DateTime?
  products Product[]
  @@unique([tenantId, code])
  @@map("units_of_measure")
}

model ProductCategory {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  code      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  syncStatus   String   @default("pending")
  version      Int      @default(1)
  lastSyncedAt DateTime?
  products Product[]
  @@unique([tenantId, code])
  @@map("product_categories")
}

model Product {
  id             String    @id @default(uuid())
  tenantId       String
  categoryId     String?
  unitId         String
  sku            String
  name           String
  barcode        String?
  costPrice      Float     @default(0)
  salePrice      Float     @default(0)
  trackInventory Boolean   @default(true)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  syncStatus     String    @default("pending")
  version        Int       @default(1)
  lastSyncedAt   DateTime?
  deviceId       String?
  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  unit           UnitOfMeasure    @relation(fields: [unitId], references: [id])
  stockBalances  StockBalance[]
  @@unique([tenantId, sku])
  @@map("products")
}

model Customer {
  id        String    @id @default(uuid())
  tenantId  String
  branchId  String?
  code      String
  name      String
  email     String?
  phone     String?
  balance   Float     @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  syncStatus   String   @default("pending")
  version      Int      @default(1)
  lastSyncedAt DateTime?
  deviceId     String?
  @@unique([tenantId, code])
  @@map("customers")
}

model Supplier {
  id        String    @id @default(uuid())
  tenantId  String
  code      String
  name      String
  email     String?
  balance   Float     @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  syncStatus   String   @default("pending")
  version      Int      @default(1)
  lastSyncedAt DateTime?
  deviceId     String?
  @@unique([tenantId, code])
  @@map("suppliers")
}

model StockBalance {
  id          String   @id @default(uuid())
  tenantId    String
  warehouseId String
  productId   String
  quantity    Float    @default(0)
  avgCost     Float    @default(0)
  updatedAt   DateTime @updatedAt
  syncStatus  String   @default("pending")
  version     Int      @default(1)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])
  @@unique([tenantId, warehouseId, productId])
  @@map("stock_balances")
}
