generator client {
  provider = "prisma-client-js"
  output   = "../generated/server"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Platform / Core ───────────────────────────────────────────────

model Tenant {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  code      String    @unique
  isActive  Boolean   @default(true)
  settings  Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branches       Branch[]
  users          User[]
  roles          Role[]
  devices        Device[]
  auditLogs      AuditLog[]
  tenantModules  TenantModule[]
  numberSequences NumberSequence[]

  @@map("tenants")
}

model Branch {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  code      String
  address   String?
  phone     String?
  email     String?
  isActive  Boolean   @default(true)
  isDefault Boolean   @default(false)
  settings  Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  warehouses  Warehouse[]
  users       User[]
  devices     Device[]
  auditLogs   AuditLog[]
  customers   Customer[]
  salesInvoices SalesInvoice[]
  purchaseOrders PurchaseOrder[]
  posShifts   PosShift[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model Warehouse {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  branchId  String    @db.Uuid
  name      String
  code      String
  address   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branch Branch @relation(fields: [branchId], references: [id])
  stockBalances StockBalance[]
  inventoryMovements InventoryMovement[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@index([tenantId, branchId])
  @@map("warehouses")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  branchId     String?   @db.Uuid
  roleId       String    @db.Uuid
  email        String
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  locale       String    @default("en")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  branch    Branch?    @relation(fields: [branchId], references: [id])
  role      Role       @relation(fields: [roleId], references: [id])
  sessions  Session[]
  auditLogs AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String
  code        String
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  users       User[]
  permissions RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  module      String
  feature     String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([module, feature, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  deviceId     String?   @db.Uuid
  refreshToken String    @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id])

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

model Device {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  branchId    String?   @db.Uuid
  name        String
  fingerprint String    @unique
  os          String?
  appVersion  String?
  status      String    @default("active")
  lastSeenAt  DateTime?
  activatedAt DateTime  @default(now())
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  branch   Branch?   @relation(fields: [branchId], references: [id])
  sessions Session[]

  @@index([tenantId])
  @@map("devices")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  branchId   String?  @db.Uuid
  userId     String?  @db.Uuid
  deviceId   String?  @db.Uuid
  entity     String
  entityId   String
  action     String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model TenantModule {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  moduleId  String
  isEnabled Boolean  @default(true)
  settings  Json     @default("{}")
  enabledAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, moduleId])
  @@map("tenant_modules")
}

model NumberSequence {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @db.Uuid
  branchId     String? @db.Uuid
  documentType String
  prefix       String
  fiscalYear   Int?
  nextNumber   Int    @default(1)
  padding      Int    @default(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, branchId, documentType, fiscalYear])
  @@map("number_sequences")
}

// ─── ERP Business Models ───────────────────────────────────────────

model UnitOfMeasure {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  code      String
  symbol    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products  Product[]
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("units_of_measure")
}

model ProductCategory {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  code      String
  parentId  String?   @db.Uuid
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  products  Product[]
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("product_categories")
}

model Product {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  categoryId     String?   @db.Uuid
  unitId         String    @db.Uuid
  sku            String
  name           String
  description    String?
  barcode        String?
  type           String    @default("product")
  costPrice      Decimal   @default(0) @db.Decimal(18, 4)
  salePrice      Decimal   @default(0) @db.Decimal(18, 4)
  taxRate        Decimal   @default(0) @db.Decimal(8, 4)
  trackInventory Boolean   @default(true)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  category       ProductCategory?   @relation(fields: [categoryId], references: [id])
  unit           UnitOfMeasure      @relation(fields: [unitId], references: [id])
  stockBalances  StockBalance[]
  inventoryMovements InventoryMovement[]
  salesInvoiceLines  SalesInvoiceLine[]
  purchaseOrderLines PurchaseOrderLine[]
  posSaleLines   PosSaleLine[]
  @@unique([tenantId, sku])
  @@index([tenantId, barcode])
  @@map("products")
}

model Customer {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  branchId         String?   @db.Uuid
  code             String
  name             String
  email            String?
  phone            String?
  address          String?
  taxNumber        String?
  creditLimit      Decimal   @default(0) @db.Decimal(18, 4)
  balance          Decimal   @default(0) @db.Decimal(18, 4)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  branch           Branch?   @relation(fields: [branchId], references: [id])
  salesInvoices    SalesInvoice[]
  customerPayments CustomerPayment[]
  posSales         PosSale[]
  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@map("customers")
}

model Supplier {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  code             String
  name             String
  email            String?
  phone            String?
  address          String?
  taxNumber        String?
  balance          Decimal   @default(0) @db.Decimal(18, 4)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  purchaseOrders   PurchaseOrder[]
  supplierPayments SupplierPayment[]
  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@map("suppliers")
}

model StockBalance {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  warehouseId String   @db.Uuid
  productId   String   @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(18, 4)
  avgCost     Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt   DateTime @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])
  @@unique([tenantId, warehouseId, productId])
  @@map("stock_balances")
}

model InventoryMovement {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  branchId      String?  @db.Uuid
  warehouseId   String   @db.Uuid
  productId     String   @db.Uuid
  movementType  String
  quantity      Decimal  @db.Decimal(18, 4)
  unitCost      Decimal  @default(0) @db.Decimal(18, 4)
  referenceType String?
  referenceId   String?
  notes         String?
  createdAt     DateTime @default(now())
  createdById   String?  @db.Uuid
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  product       Product   @relation(fields: [productId], references: [id])
  @@index([tenantId, warehouseId, productId])
  @@index([tenantId, referenceType, referenceId])
  @@map("inventory_movements")
}

model SalesInvoice {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  branchId       String    @db.Uuid
  customerId     String?   @db.Uuid
  warehouseId    String?   @db.Uuid
  number         String
  status         String    @default("draft")
  invoiceDate    DateTime  @default(now())
  dueDate        DateTime?
  subtotal       Decimal   @default(0) @db.Decimal(18, 4)
  taxAmount      Decimal   @default(0) @db.Decimal(18, 4)
  discountAmount Decimal   @default(0) @db.Decimal(18, 4)
  total          Decimal   @default(0) @db.Decimal(18, 4)
  paidAmount     Decimal   @default(0) @db.Decimal(18, 4)
  notes          String?
  postedAt       DateTime?
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  customer       Customer? @relation(fields: [customerId], references: [id])
  branch         Branch    @relation(fields: [branchId], references: [id])
  lines          SalesInvoiceLine[]
  payments       CustomerPayment[]
  @@unique([tenantId, number])
  @@index([tenantId, status, invoiceDate])
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @db.Uuid
  productId   String? @db.Uuid
  description String
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 4)
  discount    Decimal @default(0) @db.Decimal(18, 4)
  taxRate     Decimal @default(0) @db.Decimal(8, 4)
  taxAmount   Decimal @default(0) @db.Decimal(18, 4)
  lineTotal   Decimal @default(0) @db.Decimal(18, 4)
  invoice     SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product?     @relation(fields: [productId], references: [id])
  @@index([invoiceId])
  @@map("sales_invoice_lines")
}

model CustomerPayment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  branchId    String   @db.Uuid
  customerId  String   @db.Uuid
  invoiceId   String?  @db.Uuid
  number      String
  amount      Decimal  @db.Decimal(18, 4)
  paymentDate DateTime @default(now())
  method      String   @default("cash")
  reference   String?
  createdAt   DateTime @default(now())
  customer    Customer      @relation(fields: [customerId], references: [id])
  invoice     SalesInvoice? @relation(fields: [invoiceId], references: [id])
  @@unique([tenantId, number])
  @@index([tenantId, customerId])
  @@map("customer_payments")
}

model PurchaseOrder {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  branchId     String    @db.Uuid
  supplierId   String    @db.Uuid
  warehouseId  String    @db.Uuid
  number       String
  status       String    @default("draft")
  orderDate    DateTime  @default(now())
  expectedDate DateTime?
  subtotal     Decimal   @default(0) @db.Decimal(18, 4)
  taxAmount    Decimal   @default(0) @db.Decimal(18, 4)
  total        Decimal   @default(0) @db.Decimal(18, 4)
  notes        String?
  receivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  supplier     Supplier  @relation(fields: [supplierId], references: [id])
  branch       Branch    @relation(fields: [branchId], references: [id])
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  lines        PurchaseOrderLine[]
  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @db.Uuid
  productId   String  @db.Uuid
  description String
  quantity    Decimal @db.Decimal(18, 4)
  receivedQty Decimal @default(0) @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 4)
  taxRate     Decimal @default(0) @db.Decimal(8, 4)
  lineTotal   Decimal @default(0) @db.Decimal(18, 4)
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id])
  @@index([orderId])
  @@map("purchase_order_lines")
}

model SupplierPayment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  supplierId  String   @db.Uuid
  number      String
  amount      Decimal  @db.Decimal(18, 4)
  paymentDate DateTime @default(now())
  method      String   @default("cash")
  reference   String?
  createdAt   DateTime @default(now())
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  @@unique([tenantId, number])
  @@map("supplier_payments")
}

model Account {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  code         String
  name         String
  type         String
  parentId     String?   @db.Uuid
  isActive     Boolean   @default(true)
  isSystem     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  journalLines JournalLine[]
  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@map("accounts")
}

model JournalEntry {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  branchId      String?   @db.Uuid
  number        String
  entryDate     DateTime  @default(now())
  description   String?
  referenceType String?
  referenceId   String?
  status        String    @default("posted")
  createdAt     DateTime  @default(now())
  lines         JournalLine[]
  @@unique([tenantId, number])
  @@index([tenantId, entryDate])
  @@map("journal_entries")
}

model JournalLine {
  id          String  @id @default(uuid()) @db.Uuid
  entryId     String  @db.Uuid
  accountId   String  @db.Uuid
  debit       Decimal @default(0) @db.Decimal(18, 4)
  credit      Decimal @default(0) @db.Decimal(18, 4)
  description String?
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account     Account      @relation(fields: [accountId], references: [id])
  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
}

model FiscalPeriod {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  startDate DateTime
  endDate   DateTime
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([tenantId, startDate])
  @@map("fiscal_periods")
}

model PosShift {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  branchId    String    @db.Uuid
  deviceId    String?   @db.Uuid
  userId      String    @db.Uuid
  status      String    @default("open")
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  openingCash Decimal   @default(0) @db.Decimal(18, 4)
  closingCash Decimal?  @db.Decimal(18, 4)
  totalSales  Decimal   @default(0) @db.Decimal(18, 4)
  branch      Branch    @relation(fields: [branchId], references: [id])
  sales       PosSale[]
  @@index([tenantId, branchId, status])
  @@map("pos_shifts")
}

model PosSale {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  branchId   String   @db.Uuid
  shiftId    String   @db.Uuid
  customerId String?  @db.Uuid
  number     String
  status     String   @default("completed")
  subtotal   Decimal  @default(0) @db.Decimal(18, 4)
  taxAmount  Decimal  @default(0) @db.Decimal(18, 4)
  discount   Decimal  @default(0) @db.Decimal(18, 4)
  total      Decimal  @default(0) @db.Decimal(18, 4)
  saleDate   DateTime @default(now())
  syncStatus String   @default("synced")
  shift      PosShift     @relation(fields: [shiftId], references: [id])
  customer   Customer?    @relation(fields: [customerId], references: [id])
  lines      PosSaleLine[]
  payments   PosPayment[]
  @@unique([tenantId, number])
  @@index([tenantId, shiftId])
  @@map("pos_sales")
}

model PosSaleLine {
  id          String  @id @default(uuid()) @db.Uuid
  saleId      String  @db.Uuid
  productId   String  @db.Uuid
  description String
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 4)
  lineTotal   Decimal @default(0) @db.Decimal(18, 4)
  sale        PosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])
  @@index([saleId])
  @@map("pos_sale_lines")
}

model PosPayment {
  id     String  @id @default(uuid()) @db.Uuid
  saleId String  @db.Uuid
  method String
  amount Decimal @db.Decimal(18, 4)
  sale   PosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  @@index([saleId])
  @@map("pos_payments")
}

// ─── Synchronization ───────────────────────────────────────────────

model SyncQueue {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  deviceId     String    @db.Uuid
  entityType   String
  entityId     String
  operation    String
  payload      Json
  version      Int       @default(1)
  status       String    @default("pending")
  retryCount   Int       @default(0)
  lastError    String?
  idempotencyKey String  @unique
  createdAt    DateTime  @default(now())
  processedAt  DateTime?

  @@index([tenantId, deviceId, status])
  @@index([status, createdAt])
  @@map("sync_queue")
}

model SyncLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  deviceId   String   @db.Uuid
  direction  String
  entityType String?
  recordCount Int     @default(0)
  status     String
  message    String?
  startedAt  DateTime @default(now())
  completedAt DateTime?

  @@index([tenantId, deviceId, startedAt])
  @@map("sync_logs")
}

model SyncConflict {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  deviceId     String    @db.Uuid
  entityType   String
  entityId     String
  localVersion Json
  serverVersion Json
  resolution   String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([tenantId, entityType, entityId])
  @@map("sync_conflicts")
}

model SyncCursor {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  deviceId   String   @db.Uuid
  entityType String
  cursor     String
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, deviceId, entityType])
  @@map("sync_cursors")
}
