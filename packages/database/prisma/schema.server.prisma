  customer    Customer      @relation(fields: [customerId], references: [id])
  invoice     SalesInvoice? @relation(fields: [invoiceId], references: [id])
  @@unique([tenantId, number])
  @@index([tenantId, customerId])
  @@map("customer_payments")
}

model PurchaseOrder {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  branchId     String    @db.Uuid
  supplierId   String    @db.Uuid
  warehouseId  String    @db.Uuid
  number       String
  status       String    @default("draft")
  orderDate    DateTime  @default(now())
  expectedDate DateTime?
  subtotal     Decimal   @default(0) @db.Decimal(18, 4)
  taxAmount    Decimal   @default(0) @db.Decimal(18, 4)
  total        Decimal   @default(0) @db.Decimal(18, 4)
  notes        String?
  receivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  supplier     Supplier  @relation(fields: [supplierId], references: [id])
  branch       Branch    @relation(fields: [branchId], references: [id])
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  lines        PurchaseOrderLine[]
  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @db.Uuid
  productId   String  @db.Uuid
  description String
  quantity    Decimal @db.Decimal(18, 4)
  receivedQty Decimal @default(0) @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 4)
  taxRate     Decimal @default(0) @db.Decimal(8, 4)
  lineTotal   Decimal @default(0) @db.Decimal(18, 4)
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id])
  @@index([orderId])
  @@map("purchase_order_lines")
}

model SupplierPayment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  supplierId  String   @db.Uuid
  number      String
  amount      Decimal  @db.Decimal(18, 4)
  paymentDate DateTime @default(now())
  method      String   @default("cash")
  reference   String?
  createdAt   DateTime @default(now())
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  @@unique([tenantId, number])
  @@map("supplier_payments")
}

model Account {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @db.Uuid
  code          String
  name          String
  type          String
  parentId      String?               @db.Uuid
  normalBalance AccountNormalBalance?
  isPosting     Boolean               @default(true)
  isActive      Boolean               @default(true)
  isSystem      Boolean               @default(false)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  journalLines  JournalLine[]
  roleMappings  AccountRoleMapping[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@map("accounts")
}

model JournalEntry {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  branchId       String?       @db.Uuid
  fiscalPeriodId String?       @db.Uuid
  number         String
  entryDate      DateTime      @default(now())
  description    String?
  referenceType  String?
  referenceId    String?
  sourceModule   String?
  sourceType     String?
  sourceId       String?
  sourceEvent    String?
  idempotencyKey String?
  status         String        @default("posted")
  postedAt       DateTime      @default(now())
  createdAt      DateTime      @default(now())
  lines          JournalLine[]
  fiscalPeriod   FiscalPeriod? @relation(fields: [fiscalPeriodId], references: [id])

  @@unique([tenantId, number])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, sourceModule, sourceType, sourceId, sourceEvent])
  @@index([tenantId, entryDate])
  @@index([tenantId, sourceModule, sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id           String  @id @default(uuid()) @db.Uuid
  entryId      String  @db.Uuid
  accountId    String  @db.Uuid
  branchId     String? @db.Uuid
  projectId    String? @db.Uuid
  costCenterId String? @db.Uuid
  department   String?
  debit        Decimal @default(0) @db.Decimal(18, 4)
  credit       Decimal @default(0) @db.Decimal(18, 4)
  description  String?
  entry        JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  costCenter   CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  @@index([entryId])
  @@index([accountId])
  @@index([branchId])
  @@index([projectId])
  @@index([costCenterId])
  @@map("journal_lines")
}

model FiscalPeriod {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @db.Uuid
  name           String
  startDate      DateTime           @db.Date
  endDate        DateTime           @db.Date
  status         FiscalPeriodStatus @default(open)
  isClosed       Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  journalEntries JournalEntry[]

  @@index([tenantId, startDate])
  @@index([tenantId, status])
  @@map("fiscal_periods")
}

model AccountRoleMapping {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  role      String
  accountId String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])

  @@unique([tenantId, role])
  @@index([tenantId, accountId])
  @@map("finance_account_role_mappings")
}

model PostingRule {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  sourceModule String
  sourceType   String
  event        String
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lines        PostingRuleLine[]

  @@unique([tenantId, sourceModule, sourceType, event])
  @@index([tenantId, isActive])
  @@map("finance_posting_rules")
}

model PostingRuleLine {
  id           String      @id @default(uuid()) @db.Uuid
  ruleId       String      @db.Uuid
  sequence     Int
  accountRole  String
  side         PostingSide
  amountSource String
  description  String?

  rule PostingRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, sequence])
  @@map("finance_posting_rule_lines")
}

enum AccountNormalBalance {
  debit
  credit
}

enum FiscalPeriodStatus {
  open
  closed
  locked
}

enum PostingSide {
  debit
  credit
}

model PosShift {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  branchId    String    @db.Uuid
  deviceId    String?   @db.Uuid
  userId      String    @db.Uuid
  status      String    @default("open")
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  openingCash Decimal   @default(0) @db.Decimal(18, 4)
  closingCash Decimal?  @db.Decimal(18, 4)
  totalSales  Decimal   @default(0) @db.Decimal(18, 4)
  branch      Branch    @relation(fields: [branchId], references: [id])
  sales       PosSale[]
  @@index([tenantId, branchId, status])
  @@map("pos_shifts")
}

model PosSale {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  branchId   String   @db.Uuid
  shiftId    String   @db.Uuid
  customerId String?  @db.Uuid
  number     String
  status     String   @default("completed")
  subtotal   Decimal  @default(0) @db.Decimal(18, 4)
  taxAmount  Decimal  @default(0) @db.Decimal(18, 4)
  discount   Decimal  @default(0) @db.Decimal(18, 4)
  total      Decimal  @default(0) @db.Decimal(18, 4)
  saleDate   DateTime @default(now())
  syncStatus String   @default("synced")
  shift      PosShift     @relation(fields: [shiftId], references: [id])
  customer   Customer?    @relation(fields: [customerId], references: [id])
  lines      PosSaleLine[]
  payments   PosPayment[]
  @@unique([tenantId, number])
  @@index([tenantId, shiftId])
  @@map("pos_sales")
}

model PosSaleLine {
  id          String  @id @default(uuid()) @db.Uuid
  saleId      String  @db.Uuid
  productId   String  @db.Uuid
  description String
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 4)
  lineTotal   Decimal @default(0) @db.Decimal(18, 4)
  sale        PosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])
  @@index([saleId])
  @@map("pos_sale_lines")
}

model PosPayment {
  id     String  @id @default(uuid()) @db.Uuid
  saleId String  @db.Uuid
  method String
  amount Decimal @db.Decimal(18, 4)
  sale   PosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  @@index([saleId])
  @@map("pos_payments")
}

// ─── PMS Domain (Patient Management & Accounting) ─────────────────
// See docs/PMS_DOMAIN_DESIGN.md — separate from frozen ERP domain.

enum PatientStatus {
  active
  inactive
  deceased
}

enum PatientGender {
  male
  female
  other
  unknown
}

enum EncounterStatus {
  scheduled
  in_progress
  completed
  cancelled
  no_show
}

enum ChargeStatus {
  draft
  posted
  partially_paid
  paid
  voided
}

enum PaymentStatus {
  posted
  voided
  refunded
  partially_refunded
}

enum PaymentMethod {
  cash
  card
  bank_transfer
  other
}

enum RefundStatus {
  posted
  voided
}

enum AdjustmentStatus {
  posted
  voided
}

enum AdjustmentType {
  opening_balance
  credit
  debit
  write_off
}

enum AdjustmentDirection {
  increase_balance
  decrease_balance
}

enum LedgerEntryType {
  opening_balance
  charge
  discount
  payment
  refund
  adjustment
  reversal
}

enum LedgerDirection {
  debit
  credit
}

enum PatientAccountStatus {
  open
  closed
  on_hold
}

enum PatientNoteType {
  general
  billing
  administrative
}

model Patient {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @db.Uuid
  branchId     String?        @db.Uuid
  code         String
  firstName    String
  lastName     String
  fullName     String
  phone        String?
  email        String?
  address      String?
  dateOfBirth  DateTime?      @db.Date
  gender       PatientGender?
  status       PatientStatus  @default(active)
  registeredAt DateTime       @default(now())
  notes        String?
  createdById  String?        @db.Uuid
  updatedById  String?        @db.Uuid
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  branch     Branch?         @relation(fields: [branchId], references: [id])
  profile    PatientProfile?
  account    PatientAccount?
  encounters Encounter[]
  charges    Charge[]
  payments   Payment[]
  refunds    Refund[]
  adjustments Adjustment[]
  patientNotes PatientNote[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, branchId])
  @@map("pms_patients")
}

model PatientProfile {
  id                   String  @id @default(uuid()) @db.Uuid
  patientId            String  @unique @db.Uuid
  preferredLocale      String?
  referralSource       String?
  emergencyContactName String?
  emergencyContactPhone String?
  metadata             Json    @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("pms_patient_profiles")
}

model PatientNote {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  patientId   String          @db.Uuid
  content     String
  noteType    PatientNoteType @default(general)
  createdById String?         @db.Uuid
  createdAt   DateTime        @default(now())
  deletedAt   DateTime?

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, patientId, createdAt])
  @@map("pms_patient_notes")
}

model PatientAccount {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  patientId     String               @unique @db.Uuid
  cachedBalance Decimal              @default(0) @db.Decimal(18, 4)
  balanceAsOf   DateTime             @default(now())
  currency      String               @default("EGP")
  status        PatientAccountStatus @default(open)
  openedAt      DateTime             @default(now())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  patient       Patient       @relation(fields: [patientId], references: [id])
  ledgerEntries LedgerEntry[]
  charges       Charge[]
  payments      Payment[]
  refunds       Refund[]
  adjustments   Adjustment[]

  @@unique([tenantId, patientId])
  @@index([tenantId, status])
  @@map("pms_patient_accounts")
}

model ServiceCategory {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  code      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  services Service[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("pms_service_categories")
}

model Service {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  categoryId      String?   @db.Uuid
  code            String
  name            String
  description     String?
  defaultPrice    Decimal   @default(0) @db.Decimal(18, 4)
  department      String?
  durationMinutes Int?
  isActive        Boolean   @default(true)
  createdById     String?   @db.Uuid
  updatedById     String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  category   ServiceCategory? @relation(fields: [categoryId], references: [id])
  chargeLines ChargeLine[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@index([tenantId, categoryId])
  @@map("pms_services")
}

model Encounter {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @db.Uuid
  branchId      String          @db.Uuid
  patientId     String          @db.Uuid
  number        String
  encounterDate DateTime        @db.Date
  startedAt     DateTime?
  endedAt       DateTime?
  status        EncounterStatus @default(scheduled)
  providerId    String?         @db.Uuid
  department    String?
  notes         String?
  createdById   String?         @db.Uuid
  updatedById   String?         @db.Uuid
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])
  patient  Patient  @relation(fields: [patientId], references: [id])
  provider User?    @relation("EncounterProvider", fields: [providerId], references: [id])
  charges  Charge[]
  payments Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, patientId, encounterDate])
  @@index([tenantId, branchId, status])
  @@map("pms_encounters")
}

model Charge {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @db.Uuid
  branchId        String       @db.Uuid
  patientId       String       @db.Uuid
  accountId       String       @db.Uuid
  encounterId     String?      @db.Uuid
  number          String
  status          ChargeStatus @default(draft)
  chargeDate      DateTime     @db.Date
  subtotal        Decimal      @default(0) @db.Decimal(18, 4)
  discountTotal   Decimal      @default(0) @db.Decimal(18, 4)
  headerDiscount  Decimal      @default(0) @db.Decimal(18, 4)
  total           Decimal      @default(0) @db.Decimal(18, 4)
  paidAmount      Decimal      @default(0) @db.Decimal(18, 4)
  notes           String?
  postedAt        DateTime?
  postedById      String?      @db.Uuid
  voidedAt        DateTime?
  voidedById      String?      @db.Uuid
  voidReason      String?
  createdById     String?      @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  branch     Branch              @relation(fields: [branchId], references: [id])
  patient    Patient             @relation(fields: [patientId], references: [id])
  account    PatientAccount      @relation(fields: [accountId], references: [id])
  encounter  Encounter?          @relation(fields: [encounterId], references: [id])
  lines      ChargeLine[]
  allocations PaymentAllocation[]

  @@unique([tenantId, number])
  @@index([tenantId, patientId, status])
  @@index([tenantId, branchId, chargeDate])
  @@index([tenantId, accountId])
  @@map("pms_charges")
}

model ChargeLine {
  id              String  @id @default(uuid()) @db.Uuid
  chargeId        String  @db.Uuid
  serviceId       String? @db.Uuid
  serviceCode     String
  serviceName     String
  description     String?
  quantity        Decimal @default(1) @db.Decimal(18, 4)
  unitPrice       Decimal @db.Decimal(18, 4)
  lineSubtotal    Decimal @default(0) @db.Decimal(18, 4)
  discountAmount  Decimal @default(0) @db.Decimal(18, 4)
  discountPercent Decimal @default(0) @db.Decimal(8, 4)
  lineTotal       Decimal @default(0) @db.Decimal(18, 4)
  sortOrder       Int     @default(0)

  charge  Charge   @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id])

  @@index([chargeId])
  @@map("pms_charge_lines")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  branchId       String        @db.Uuid
  patientId      String        @db.Uuid
  accountId      String        @db.Uuid
  encounterId    String?       @db.Uuid
  number         String
  amount         Decimal       @db.Decimal(18, 4)
  method         PaymentMethod @default(cash)
  reference      String?
  notes          String?
  paymentDate    DateTime      @db.Date
  status         PaymentStatus @default(posted)
  idempotencyKey String
  postedAt       DateTime      @default(now())
  postedById     String?       @db.Uuid
  voidedAt       DateTime?
  voidedById     String?       @db.Uuid
  voidReason     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  branch      Branch              @relation(fields: [branchId], references: [id])
  patient     Patient             @relation(fields: [patientId], references: [id])
  account     PatientAccount      @relation(fields: [accountId], references: [id])
  encounter   Encounter?          @relation(fields: [encounterId], references: [id])
  allocations PaymentAllocation[]
  refunds     Refund[]

  @@unique([tenantId, number])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, patientId, paymentDate])
  @@index([tenantId, branchId, paymentDate])
  @@index([tenantId, accountId])
  @@map("pms_payments")
}

model PaymentAllocation {
  id        String  @id @default(uuid()) @db.Uuid
  paymentId String  @db.Uuid
  chargeId  String  @db.Uuid
  amount    Decimal @db.Decimal(18, 4)
  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  charge  Charge  @relation(fields: [chargeId], references: [id])

  @@unique([paymentId, chargeId])
  @@index([chargeId])
  @@map("pms_payment_allocations")
}

model Refund {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  branchId    String       @db.Uuid
  patientId   String       @db.Uuid
  accountId   String       @db.Uuid
  paymentId   String       @db.Uuid
  number      String
  amount      Decimal      @db.Decimal(18, 4)
  reason      String
  method      PaymentMethod @default(cash)
  status      RefundStatus @default(posted)
  refundDate  DateTime     @db.Date
  postedAt    DateTime     @default(now())
  postedById  String?      @db.Uuid
  voidedAt    DateTime?
  voidedById  String?      @db.Uuid
  createdAt   DateTime     @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  branch  Branch         @relation(fields: [branchId], references: [id])
  patient Patient        @relation(fields: [patientId], references: [id])
  account PatientAccount @relation(fields: [accountId], references: [id])
  payment Payment        @relation(fields: [paymentId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId, paymentId])
  @@index([tenantId, patientId, refundDate])
  @@map("pms_refunds")
}

model Adjustment {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @db.Uuid
  branchId       String              @db.Uuid
  patientId      String              @db.Uuid
  accountId      String              @db.Uuid
  number         String
  adjustmentType AdjustmentType
  direction      AdjustmentDirection
  amount         Decimal             @db.Decimal(18, 4)
  reason         String
  status         AdjustmentStatus    @default(posted)
  adjustmentDate DateTime            @db.Date
  approvedById   String?             @db.Uuid
  postedAt       DateTime            @default(now())
  postedById     String?             @db.Uuid
  voidedAt       DateTime?
  voidedById     String?             @db.Uuid
  createdAt      DateTime            @default(now())

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  branch  Branch         @relation(fields: [branchId], references: [id])
  patient Patient        @relation(fields: [patientId], references: [id])
  account PatientAccount @relation(fields: [accountId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId, patientId, adjustmentDate])
  @@index([tenantId, accountId])
  @@map("pms_adjustments")
}

model LedgerEntry {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @db.Uuid
  branchId       String          @db.Uuid
  accountId      String          @db.Uuid
  entryType      LedgerEntryType
  direction      LedgerDirection
  amount         Decimal         @db.Decimal(18, 4)
  currency       String
  entryDate      DateTime        @db.Date
  postedAt       DateTime        @default(now())
  referenceType  String
  referenceId    String          @db.Uuid
  reversalOfId   String?         @db.Uuid
  description    String?
  runningBalance Decimal         @db.Decimal(18, 4)
  createdById    String?         @db.Uuid
  createdAt      DateTime        @default(now())

  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  branch     Branch         @relation(fields: [branchId], references: [id])
  account    PatientAccount @relation(fields: [accountId], references: [id])
  reversalOf LedgerEntry?   @relation("LedgerReversal", fields: [reversalOfId], references: [id])
  reversals  LedgerEntry[]  @relation("LedgerReversal")

  @@index([accountId, postedAt])
  @@index([tenantId, referenceType, referenceId])
  @@index([tenantId, branchId, entryDate])
  @@map("pms_ledger_entries")
}

// ─── Synchronization ───────────────────────────────────────────────

model SyncQueue {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  deviceId     String    @db.Uuid
  entityType   String
  entityId     String
  operation    String
  payload      Json
  version      Int       @default(1)
  status       String    @default("pending")
  retryCount   Int       @default(0)
  lastError    String?
  idempotencyKey String  @unique
  createdAt    DateTime  @default(now())
  processedAt  DateTime?

  @@index([tenantId, deviceId, status])
  @@index([status, createdAt])
  @@map("sync_queue")
}

model SyncLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  deviceId   String   @db.Uuid
  direction  String
  entityType String?
  recordCount Int     @default(0)
  status     String
  message    String?
  startedAt  DateTime @default(now())
  completedAt DateTime?

  @@index([tenantId, deviceId, startedAt])
  @@map("sync_logs")
}

model SyncConflict {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  deviceId     String    @db.Uuid
  entityType   String
  entityId     String
  localVersion Json
  serverVersion Json
  resolution   String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([tenantId, entityType, entityId])
  @@map("sync_conflicts")
}

model SyncCursor {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  deviceId   String   @db.Uuid
  entityType String
  cursor     String
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, deviceId, entityType])
  @@map("sync_cursors")
}
