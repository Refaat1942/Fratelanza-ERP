generator client {
  provider = "prisma-client-js"
  output   = "../generated/server"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Platform / Core ───────────────────────────────────────────────

model Tenant {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  code      String    @unique
  isActive  Boolean   @default(true)
  settings  Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branches       Branch[]
  users          User[]
  roles          Role[]
  devices        Device[]
  auditLogs      AuditLog[]
  tenantModules  TenantModule[]
  numberSequences NumberSequence[]
  pmsPatients         Patient[]
  pmsPatientAccounts  PatientAccount[]
  pmsServiceCategories ServiceCategory[]
  pmsServices         Service[]
  pmsEncounters       Encounter[]
  pmsCharges          Charge[]
  pmsPayments         Payment[]
  pmsRefunds          Refund[]
  pmsAdjustments      Adjustment[]
  pmsLedgerEntries    LedgerEntry[]
  parties             Party[]
  projects            Project[]
  costCenters         CostCenter[]
  constructionProjectProfiles ConstructionProjectProfile[]
  constructionCostEntries   ConstructionCostEntry[]
  constructionContracts     ConstructionContract[]
  constructionBoqs          ConstructionBoq[]
  constructionBoqSections   ConstructionBoqSection[]
  constructionBoqItems      ConstructionBoqItem[]
  constructionProgress      ConstructionProgress[]
  constructionProgressItems ConstructionProgressItem[]
  constructionVariations    ConstructionVariation[]
  constructionVariationItems ConstructionVariationItem[]
  constructionRetentionEntries ConstructionRetentionEntry[]
  constructionAdvanceEntries ConstructionAdvanceEntry[]
  constructionSubcontractorProfiles ConstructionSubcontractorProfile[]
  constructionSubcontractorAssignments ConstructionSubcontractorAssignment[]
  constructionMaterialIssues ConstructionMaterialIssue[]
  constructionMaterialIssueLines ConstructionMaterialIssueLine[]
  license             TenantLicense?

  @@map("tenants")
}

model Branch {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  code      String
  address   String?
  phone     String?
  email     String?
  isActive  Boolean   @default(true)
  isDefault Boolean   @default(false)
  settings  Json      @default("{}")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  warehouses  Warehouse[]
  users       User[]
  devices     Device[]
  auditLogs   AuditLog[]
  customers   Customer[]
  salesInvoices SalesInvoice[]
  purchaseOrders PurchaseOrder[]
  posShifts   PosShift[]
  pmsPatients    Patient[]
  pmsEncounters  Encounter[]
  pmsCharges     Charge[]
  pmsPayments    Payment[]
  pmsRefunds     Refund[]
  pmsAdjustments Adjustment[]
  pmsLedgerEntries LedgerEntry[]
  projects         Project[]
  costCenters      CostCenter[]
  constructionCostEntries ConstructionCostEntry[]
  constructionContracts ConstructionContract[]
  constructionProgress ConstructionProgress[]
  constructionVariations ConstructionVariation[]
  constructionRetentionEntries ConstructionRetentionEntry[]
  constructionAdvanceEntries ConstructionAdvanceEntry[]
  constructionMaterialIssues ConstructionMaterialIssue[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model Warehouse {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  branchId  String    @db.Uuid
  name      String
  code      String
  address   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branch Branch @relation(fields: [branchId], references: [id])
  stockBalances StockBalance[]
  inventoryMovements InventoryMovement[]
  purchaseOrders PurchaseOrder[]
  constructionMaterialIssues ConstructionMaterialIssue[]

  @@unique([tenantId, code])
  @@index([tenantId, branchId])
  @@map("warehouses")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  branchId     String?   @db.Uuid
  roleId       String    @db.Uuid
  email        String
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  locale       String    @default("en")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  branch    Branch?    @relation(fields: [branchId], references: [id])
  role      Role       @relation(fields: [roleId], references: [id])
  sessions  Session[]
  auditLogs AuditLog[]
  pmsEncountersAsProvider Encounter[] @relation("EncounterProvider")
  managedProjects         Project[]   @relation("ProjectManager")
  constructionProfilesCreated ConstructionProjectProfile[] @relation("ConstructionProfileCreator")
  constructionCostEntriesCreated ConstructionCostEntry[] @relation("ConstructionCostEntryCreator")
  constructionContractsCreated ConstructionContract[] @relation("ConstructionContractCreator")
  constructionBoqsCreated ConstructionBoq[] @relation("ConstructionBoqCreator")
  constructionBoqsApproved ConstructionBoq[] @relation("ConstructionBoqApprover")
  constructionProgressCreated ConstructionProgress[] @relation("ConstructionProgressCreator")
  constructionProgressSubmitted ConstructionProgress[] @relation("ConstructionProgressSubmitter")
  constructionProgressApproved ConstructionProgress[] @relation("ConstructionProgressApprover")
  constructionProgressRejected ConstructionProgress[] @relation("ConstructionProgressRejecter")
  constructionVariationsCreated ConstructionVariation[] @relation("ConstructionVariationCreator")
  constructionVariationsSubmitted ConstructionVariation[] @relation("ConstructionVariationSubmitter")
  constructionVariationsApproved ConstructionVariation[] @relation("ConstructionVariationApprover")
  constructionVariationsRejected ConstructionVariation[] @relation("ConstructionVariationRejecter")
  constructionRetentionEntriesCreated ConstructionRetentionEntry[] @relation("ConstructionRetentionEntryCreator")
  constructionAdvanceEntriesCreated ConstructionAdvanceEntry[] @relation("ConstructionAdvanceEntryCreator")
  constructionSubcontractorProfilesCreated ConstructionSubcontractorProfile[] @relation("ConstructionSubcontractorProfileCreator")
  constructionSubcontractorAssignmentsCreated ConstructionSubcontractorAssignment[] @relation("ConstructionSubcontractorAssignmentCreator")
  constructionMaterialIssuesCreated ConstructionMaterialIssue[] @relation("ConstructionMaterialIssueCreator")
  constructionMaterialIssuesIssued ConstructionMaterialIssue[] @relation("ConstructionMaterialIssueIssuer")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String
  code        String
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  users       User[]
  permissions RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  module      String
  feature     String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([module, feature, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  deviceId     String?   @db.Uuid
  refreshToken String    @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id])

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

model Device {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  branchId    String?   @db.Uuid
  name        String
  fingerprint String    @unique
  os          String?
  appVersion  String?
  status      String    @default("active")
  lastSeenAt  DateTime?
  activatedAt DateTime  @default(now())
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  branch   Branch?   @relation(fields: [branchId], references: [id])
  sessions Session[]

  @@index([tenantId])
  @@map("devices")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  branchId   String?  @db.Uuid
  userId     String?  @db.Uuid
  deviceId   String?  @db.Uuid
  entity     String
  entityId   String
  action     String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model TenantModule {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  moduleId  String
  isEnabled Boolean  @default(true)
  settings  Json     @default("{}")
  enabledAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, moduleId])
  @@map("tenant_modules")
}

enum LicenseStatus {
  pending
  active
  grace
  expired
  suspended
  revoked
}

enum LicenseType {
  perpetual
  time_limited
}

enum EntitlementTermType {
  perpetual
  time_limited
}

enum LicenseEdition {
  starter
  professional
  business
  enterprise
}

model TenantLicense {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @unique @db.Uuid
  licenseKey       String         @unique
  licenseType      LicenseType    @default(perpetual)
  edition          LicenseEdition @default(business)
  status           LicenseStatus  @default(pending)
  schemaVersion    Int            @default(1)
  issuedAt         DateTime       @default(now())
  activatedAt      DateTime?
  expiresAt        DateTime?
  graceEndsAt      DateTime?
  maxUsers         Int            @default(25)
  maxBranches      Int            @default(5)
  maxDevices       Int            @default(10)
  maxStorageMb     Int?
  installationId   String?
  payloadDigest    String?
  payloadSignature String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant   Tenant                      @relation(fields: [tenantId], references: [id])
  modules  LicenseModuleEntitlement[]
  features LicenseFeatureEntitlement[]

  @@index([tenantId, status])
  @@map("tenant_licenses")
}

model LicenseModuleEntitlement {
  id        String              @id @default(uuid()) @db.Uuid
  tenantId  String              @db.Uuid
  licenseId String              @db.Uuid
  moduleKey String
  termType  EntitlementTermType @default(perpetual)
  expiresAt DateTime?
  isEnabled Boolean             @default(true)
  enabledAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  license TenantLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, moduleKey])
  @@unique([tenantId, moduleKey])
  @@index([tenantId, isEnabled])
  @@map("license_module_entitlements")
}

model LicenseFeatureEntitlement {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  licenseId  String   @db.Uuid
  featureKey String
  isEnabled  Boolean  @default(true)
  enabledAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  license TenantLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@unique([licenseId, featureKey])
  @@unique([tenantId, featureKey])
  @@index([tenantId, isEnabled])
  @@map("license_feature_entitlements")
}

model NumberSequence {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @db.Uuid
  branchId     String? @db.Uuid
  documentType String
  prefix       String
  fiscalYear   Int?
  nextNumber   Int    @default(1)
  padding      Int    @default(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, branchId, documentType, fiscalYear])
  @@map("number_sequences")
}

// ─── ERP Business Models ───────────────────────────────────────────

model UnitOfMeasure {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  code      String
  symbol    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products  Product[]
  constructionBoqItems ConstructionBoqItem[]
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("units_of_measure")
}

model ProductCategory {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  code      String
  parentId  String?   @db.Uuid
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  products  Product[]
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("product_categories")
}

model Product {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  categoryId     String?   @db.Uuid
  unitId         String    @db.Uuid
  sku            String
  name           String
  description    String?
  barcode        String?
  type           String    @default("product")
  costPrice      Decimal   @default(0) @db.Decimal(18, 4)
  salePrice      Decimal   @default(0) @db.Decimal(18, 4)
  taxRate        Decimal   @default(0) @db.Decimal(8, 4)
  trackInventory Boolean   @default(true)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  category       ProductCategory?   @relation(fields: [categoryId], references: [id])
  unit           UnitOfMeasure      @relation(fields: [unitId], references: [id])
  stockBalances  StockBalance[]
  inventoryMovements InventoryMovement[]
  salesInvoiceLines  SalesInvoiceLine[]
  purchaseOrderLines PurchaseOrderLine[]
  posSaleLines   PosSaleLine[]
  constructionBoqItems ConstructionBoqItem[]
  constructionMaterialIssueLines ConstructionMaterialIssueLine[]
  @@unique([tenantId, sku])
  @@index([tenantId, barcode])
  @@map("products")
}

model Customer {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  branchId         String?   @db.Uuid
  partyId          String?   @unique @db.Uuid
  code             String
  name             String
  email            String?
  phone            String?
  address          String?
  taxNumber        String?
  creditLimit      Decimal   @default(0) @db.Decimal(18, 4)
  balance          Decimal   @default(0) @db.Decimal(18, 4)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  branch           Branch?   @relation(fields: [branchId], references: [id])
  party            Party?    @relation(fields: [partyId], references: [id])
  salesInvoices    SalesInvoice[]
  customerPayments CustomerPayment[]
  posSales         PosSale[]
  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@map("customers")
}

model Supplier {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  partyId          String?   @unique @db.Uuid
  code             String
  name             String
  email            String?
  phone            String?
  address          String?
  taxNumber        String?
  balance          Decimal   @default(0) @db.Decimal(18, 4)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  party            Party?    @relation(fields: [partyId], references: [id])
  purchaseOrders   PurchaseOrder[]
  supplierPayments SupplierPayment[]
  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@map("suppliers")
}

enum PartyType {
  individual
  organization
}

enum PartyStatus {
  active
  archived
}

enum PartyRoleType {
  customer
  supplier
  contractor
  subcontractor
}

enum PartyAddressType {
  billing
  shipping
  office
  home
  other
}

enum PartyIdentifierType {
  tax_id
  vat
  commercial_registration
  national_id
  other
}

model Party {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @db.Uuid
  type        PartyType
  code        String
  displayName String
  legalName   String?
  email       String?
  phone       String?
  website     String?
  notes       String?
  status      PartyStatus @default(active)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  roles       PartyRole[]
  contacts    PartyContact[]
  addresses   PartyAddress[]
  identifiers PartyIdentifier[]
  customer    Customer?
  supplier    Supplier?
  customerProjects Project[] @relation("ProjectCustomerParty")
  constructionContracts ConstructionContract[]
  constructionSubcontractorProfiles ConstructionSubcontractorProfile[]

  @@unique([tenantId, code])
  @@index([tenantId, displayName])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@map("parties")
}

enum ProjectStatus {
  draft
  active
  on_hold
  completed
  cancelled
  archived
}

model Project {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @db.Uuid
  branchId          String?       @db.Uuid
  code              String
  name              String
  description       String?
  status            ProjectStatus @default(draft)
  startDate         DateTime?     @db.Date
  endDate           DateTime?     @db.Date
  customerPartyId   String?       @db.Uuid
  managerUserId     String?       @db.Uuid
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  branch        Branch?     @relation(fields: [branchId], references: [id])
  customerParty Party?      @relation("ProjectCustomerParty", fields: [customerPartyId], references: [id], onDelete: SetNull)
  manager       User?       @relation("ProjectManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  costCenters   CostCenter[]
  journalLines  JournalLine[]
  constructionProfile ConstructionProjectProfile?
  constructionCostEntries ConstructionCostEntry[]
  constructionContracts ConstructionContract[]
  constructionBoqs ConstructionBoq[]
  constructionProgress ConstructionProgress[]
  constructionVariations ConstructionVariation[]
  constructionRetentionEntries ConstructionRetentionEntry[]
  constructionAdvanceEntries ConstructionAdvanceEntry[]
  constructionSubcontractorAssignments ConstructionSubcontractorAssignment[]
  constructionMaterialIssues ConstructionMaterialIssue[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, branchId])
  @@map("projects")
}

model CostCenter {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  branchId    String?  @db.Uuid
  parentId    String?  @db.Uuid
  projectId   String?  @db.Uuid
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  branch   Branch?      @relation(fields: [branchId], references: [id])
  parent   CostCenter?  @relation("CostCenterHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children CostCenter[] @relation("CostCenterHierarchy")
  project  Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  journalLines JournalLine[]
  constructionCostEntries ConstructionCostEntry[]
  constructionBoqItems ConstructionBoqItem[]
  constructionProgressItems ConstructionProgressItem[]
  constructionVariationItems ConstructionVariationItem[]
  constructionMaterialIssues ConstructionMaterialIssue[]
  constructionMaterialIssueLines ConstructionMaterialIssueLine[]

  @@unique([tenantId, code])
  @@index([tenantId, projectId])
  @@index([tenantId, parentId])
  @@index([tenantId, isActive])
  @@map("cost_centers")
}

enum ConstructionContractDirection {
  customer
  subcontractor
}

enum ConstructionContractPricingModel {
  lump_sum
  unit_price
  cost_plus
  mixed
}

enum ConstructionContractStatus {
  draft
  active
  suspended
  completed
  cancelled
  archived
}

enum ConstructionBoqStatus {
  draft
  approved
  superseded
  archived
}

enum ConstructionCostCategory {
  material
  labor
  subcontract
  equipment
  other
}

model ConstructionProjectProfile {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  projectId   String   @unique @db.Uuid
  notes       String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ConstructionProfileCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([tenantId, projectId])
  @@index([tenantId])
  @@map("construction_project_profiles")
}

model ConstructionCostEntry {
  id           String                   @id @default(uuid()) @db.Uuid
  tenantId     String                   @db.Uuid
  projectId    String                   @db.Uuid
  branchId     String                   @db.Uuid
  costCenterId String?                  @db.Uuid
  category     ConstructionCostCategory
  amount       Decimal                  @db.Decimal(18, 4)
  currency     String                   @default("EGP")
  sourceModule String
  sourceType   String
  sourceId     String                   @db.Uuid
  sourceEvent  String
  description  String?
  occurredAt   DateTime                 @db.Date
  createdById  String?                  @db.Uuid
  createdAt    DateTime                 @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branch     Branch      @relation(fields: [branchId], references: [id])
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("ConstructionCostEntryCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([tenantId, sourceModule, sourceType, sourceId, sourceEvent])
  @@index([tenantId, projectId, occurredAt])
  @@index([tenantId, costCenterId])
  @@map("construction_cost_entries")
}

model ConstructionContract {
  id                  String                           @id @default(uuid()) @db.Uuid
  tenantId            String                           @db.Uuid
  projectId           String                           @db.Uuid
  branchId            String                           @db.Uuid
  number              String
  title               String
  description         String?
  direction           ConstructionContractDirection
  partyId             String                           @db.Uuid
  pricingModel        ConstructionContractPricingModel
  originalValue       Decimal                          @default(0) @db.Decimal(18, 4)
  revisedValue        Decimal?                         @db.Decimal(18, 4)
  originalValueLocked Boolean                          @default(false)
  currency            String                           @default("EGP")
  startDate           DateTime?                        @db.Date
  endDate             DateTime?                        @db.Date
  retentionPercent    Decimal?                         @db.Decimal(8, 4)
  retentionCap        Decimal?                         @db.Decimal(18, 4)
  advanceAmount       Decimal?                         @db.Decimal(18, 4)
  advancePercent      Decimal?                         @db.Decimal(8, 4)
  paymentTerms        String?
  status              ConstructionContractStatus       @default(draft)
  createdById         String?                          @db.Uuid
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt

  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branch    Branch  @relation(fields: [branchId], references: [id])
  party     Party   @relation(fields: [partyId], references: [id])
  createdBy User?   @relation("ConstructionContractCreator", fields: [createdById], references: [id], onDelete: SetNull)
  boqs      ConstructionBoq[]
  progress  ConstructionProgress[]
  variations ConstructionVariation[]
  retentionEntries ConstructionRetentionEntry[]
  advanceEntries ConstructionAdvanceEntry[]
  subcontractorAssignments ConstructionSubcontractorAssignment[]

  @@unique([tenantId, number])
  @@index([tenantId, projectId])
  @@index([tenantId, status])
  @@index([tenantId, partyId])
  @@map("construction_contracts")
}

model ConstructionBoq {
  id                  String                @id @default(uuid()) @db.Uuid
  tenantId            String                @db.Uuid
  projectId           String                @db.Uuid
  contractId          String                @db.Uuid
  number              String
  revisionNumber      Int                   @default(1)
  supersedesBoqId     String?               @db.Uuid
